# Production environment for docker-compose.prod.yml.
# Copy to .env.production and fill in real values:
#   cp .env.production.example .env.production
# Every variable here is REQUIRED for the stack to boot unless marked optional.
# Comments must be on their own line (Compose does not strip inline "# ..." comments).

DJANGO_DEBUG=0

# Long random strings. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret

# How the app is reached publicly (consumed by Caddy).
#   Quick HTTP test on a bare IP (no certificate):   http://178.105.171.222
#   Production with a domain (Caddy auto-fetches a Let's Encrypt cert):
#     elearning.example.edu
#   Use a bare host, no scheme/slash.
# The domain's DNS A record must point at this server, and ports 80+443 open.
CADDY_SITE_ADDRESS=http://178.105.171.222

# Comma-separated; every host the app is served on (domain and/or IP).
DJANGO_ALLOWED_HOSTS=178.105.171.222
# Comma-separated WITH scheme. Switch to https:// once you have a domain + TLS.
DJANGO_CSRF_TRUSTED_ORIGINS=http://178.105.171.222

# Database. The password inside DATABASE_URL must EXACTLY match POSTGRES_PASSWORD.
# Postgres only sets this password on the first boot of an empty data volume.
DATABASE_URL=postgres://elearning:change-this-db-password@db:5432/elearning
POSTGRES_PASSWORD=change-this-db-password

# Researcher login password, stored as a HASH (plaintext is rejected in prod).
# Generate it without touching the database:
#   docker compose --env-file .env.production -f docker-compose.prod.yml \
#     run --rm --no-deps --entrypoint python web manage.py hash_admin_password
# IMPORTANT: the hash key is RESEARCH_ADMIN_PASSWORD_HASH (note the _HASH suffix).
# A pbkdf2 hash contains "$", which Compose reads as variable interpolation, so
# DOUBLE every "$" to "$$" here (Compose turns "$$" back into a literal "$"):
#   RESEARCH_ADMIN_PASSWORD_HASH=pbkdf2_sha256$$870000$$<salt>$$<hash>
# Verify after deploy:  exec web sh -c 'printf "%s\n" "$RESEARCH_ADMIN_PASSWORD_HASH"'
RESEARCH_ADMIN_PASSWORD_HASH=

# Cookies. Fine as Lax/0 for an HTTP test. For Moodle iframe embedding over
# HTTPS you MUST set DJANGO_COOKIE_SAMESITE=None and DJANGO_COOKIE_SECURE=1
# (browsers only send third-party iframe cookies when they are SameSite=None; Secure).
DJANGO_COOKIE_SAMESITE=Lax
DJANGO_COOKIE_SECURE=0

# Activities can be embedded from any Moodle/LMS domain; no allowlist is needed.

# Optional: error tracking. Set a DSN to enable Sentry.
# SENTRY_DSN=
# Optional: polite identifier for OpenStreetMap/Nominatim lookups (include a contact email).
# NOMINATIM_USER_AGENT=elearning-iframe/1.0 (you@example.edu)
